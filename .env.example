# ---- App ----
NODE_ENV=production
PORT=3001
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me

# ---- Database ----
# Option A: connection string. Append ?sslmode=require to enable SSL,
# needed by managed Postgres (Neon, Supabase, RDS...). Omit it for plain TCP.
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Option B: discrete vars (never SSL). Use for Postgres on the same internal
# network (Coolify, docker-compose). Do not set DATABASE_URL as well.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cursos

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket / CDN base URL, no trailing slash
R2_PUBLIC_URL=

# ---- Seed (first boot only) ----
# Set to true once to create the admin user, then turn it off.
SEED_ON_BOOT=false
# Required when SEED_ON_BOOT=true and NODE_ENV=production
SEED_ADMIN_PASSWORD=
